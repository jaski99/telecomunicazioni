{
  "id": "dim-pm-fm-trasformazione",
  "titolo": "Trasformazione tra PM e FM",
  "domande_esame": [
    "T9"
  ],
  "enunciato": "Un modulatore PM preceduto da un integratore realizza una FM; un modulatore FM preceduto da un derivatore realizza una PM, scegliendo guadagni e condizioni iniziali compatibili.",
  "ipotesi": [
    "Modulatori ideali con sensibilità costanti non nulle.",
    "Il messaggio è derivabile per la catena con derivatore; le condizioni iniziali e la fase costante sono controllate.",
    "Per la seconda identità della formula finale, la fase iniziale del modulatore FM è $\\theta_0=k_p m(t_0)$."
  ],
  "notazione": [
    {
      "simbolo": "m(t)",
      "significato": "Messaggio modulante."
    },
    {
      "simbolo": "k_p",
      "significato": "Sensibilità di fase del modulatore PM."
    },
    {
      "simbolo": "k_f",
      "significato": "Sensibilità di frequenza angolare del modulatore FM."
    },
    {
      "simbolo": "\\omega_0",
      "significato": "Pulsazione della portante."
    },
    {
      "simbolo": "\\theta_{PM}(t),\\theta_{FM}(t)",
      "significato": "Fasi eccedenti ideali dei due modulatori."
    },
    {
      "simbolo": "\\theta_0",
      "significato": "Fase iniziale regolabile della modulazione in frequenza."
    },
    {
      "simbolo": "\\mathrm{PM}\\{u\\},\\mathrm{FM}\\{u\\}",
      "significato": "Segnali modulati con ingresso u, che può essere un integrale o una derivata del messaggio."
    },
    {
      "simbolo": "u(t)",
      "significato": "Segnale applicato all’ingresso del modulatore considerato."
    },
    {
      "simbolo": "t_0",
      "significato": "Istante iniziale scelto per gli integrali di fase."
    }
  ],
  "idea": "Confrontare le fasi istantanee: integrare prima della PM e derivare prima della FM.",
  "passi": [
    {
      "n": 1,
      "testo": "Definire la fase eccedente della PM.",
      "formula": "\\theta_{PM}(t)=k_p m(t)",
      "perche": "Nel modello ideale la fase eccedente della PM dipende linearmente dal suo ingresso; non si assume lineare il segnale portante.",
      "figura": "fase-pm"
    },
    {
      "n": 2,
      "testo": "Definire la fase eccedente della FM.",
      "formula": "\\theta_{FM}(t)=k_f\\int_{t_0}^{t}m(\\tau)\\,d\\tau+\\theta_0",
      "perche": "Nel modello ideale la deviazione di pulsazione è la derivata temporale della fase eccedente, a meno della fase iniziale.",
      "figura": "fase-fm"
    },
    {
      "n": 3,
      "testo": "Anteporre un integratore alla PM.",
      "formula": "u(t)=\\frac{k_f}{k_p}\\int_{t_0}^{t}m(\\tau)\\,d\\tau+\\frac{\\theta_0}{k_p}",
      "perche": "Sostituendo u alla modulante PM si ottiene esattamente la fase FM.",
      "figura": "pm-verso-fm"
    },
    {
      "n": 4,
      "testo": "Anteporre un derivatore alla FM.",
      "formula": "u(t)=\\frac{k_p}{k_f}\\frac{dm(t)}{dt}",
      "perche": "Il derivatore va all’ingresso della FM: cercando $k_f\\int u=k_pm$ si ottiene il guadagno indicato, a meno della costante iniziale.",
      "figura": "fm-verso-pm"
    },
    {
      "n": 5,
      "testo": "Regolare la fase iniziale della catena FM.",
      "formula": "\\theta_0=k_p m(t_0)",
      "perche": "Ipotesi: fase iniziale regolabile. Altrimenti resta la differenza costante $\\theta_0-k_pm(t_0)$ rispetto alla fase della PM."
    }
  ],
  "formula_finale": "\\mathrm{PM}\\{\\frac{k_f}{k_p}\\int_{t_0}^{t}m(\\tau)\\,d\\tau+\\frac{\\theta_0}{k_p}\\}=\\mathrm{FM}\\{m\\},\\quad \\mathrm{FM}\\{\\frac{k_p}{k_f}m^{\\prime}\\}=\\mathrm{PM}\\{m\\}",
