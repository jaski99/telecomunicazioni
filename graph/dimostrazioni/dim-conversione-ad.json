  "idea": "Separare la discretizzazione del tempo da quantizzazione e codifica dei valori.",
  "passi": [
    {
      "n": 1,
      "testo": "Limitare la banda e scegliere il campionamento.",
      "formula": "\\omega_s=\\frac{2\\pi}{T}>2\\omega_m",
      "perche": "La separazione delle repliche evita aliasing per un segnale limitato in banda."
    },
    {
      "n": 2,
      "testo": "Prelevare i campioni.",
      "formula": "x_n=x(nT)",
      "perche": "La lettura agli istanti nT discretizza il tempo senza ancora quantizzare le ampiezze.",
      "figura": "campionamento"
    },
    {
      "n": 3,
      "testo": "Quantizzare ogni campione.",
      "formula": "q_n=Q(x_n),\\quad q_n\\in\\{q_1,\\ldots,q_L\\}",
      "perche": "Il quantizzatore associa a ciascun intervallo un livello rappresentativo."
    },
    {
      "n": 4,
      "testo": "Codificare ciascun livello.",
      "formula": "b=\\lceil\\log_2 L\\rceil,\\quad 2^b\\ge L",
      "perche": "Le parole binarie di lunghezza b sono 2 alla b e devono distinguere tutti i livelli."
    },
    {
      "n": 5,
      "testo": "Calcolare la velocità binaria senza bit aggiuntivi.",
      "formula": "R_b=\\frac{b}{T}=b f_s",
      "perche": "Ogni campione produce b bit e i campioni si ripetono alla frequenza fs."
    }
  ],
  "formula_finale": "x(t)\\longrightarrow x_n\\longrightarrow q_n\\longrightarrow (b_n^{(1)},\\ldots,b_n^{(b)})",
