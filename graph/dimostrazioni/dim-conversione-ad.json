{
  "id": "dim-conversione-ad",
  "titolo": "Descrivere i tre passi della conversione A/D e il segnale numerico ottenuto",
  "domande_esame": [
    "T7"
  ],
  "enunciato": "La conversione A/D campiona il segnale con $\\omega_s>2\\omega_m$, quantizza i campioni su $L$ livelli e codifica ciascun livello con $b=\\lceil\\log_2 L\\rceil$ bit. La sequenza delle parole costituisce il segnale numerico PCM.",
  "ipotesi": [
    "Segnale limitato in banda a $\\omega_{m}$ e campionamento ideale con $\\omega_{s} > 2\\omega_{m}$; l’uguaglianza richiede condizioni ulteriori.",
    "Il quantizzatore ha L livelli e il segnale resta nell’intervallo di ingresso senza sovraccarico."
  ],
  "notazione": [
    {
      "simbolo": "x(t)",
      "significato": "Segnale analogico."
    },
    {
      "simbolo": "T",
      "significato": "Periodo di campionamento."
    },
    {
      "simbolo": "x_n",
      "significato": "Campione x(nT)."
    },
    {
      "simbolo": "q_n",
      "significato": "Livello quantizzato associato al campione."
    },
    {
      "simbolo": "L",
      "significato": "Numero di livelli."
    },
    {
      "simbolo": "b",
      "significato": "Numero di bit per parola."
    },
    {
      "simbolo": "f_s=1/T",
      "significato": "Frequenza di campionamento."
    },
    {
      "simbolo": "\\omega_s=2\\pi f_s",
      "significato": "Pulsazione di campionamento."
    },
    {
      "simbolo": "\\omega_m",
      "significato": "Massima pulsazione del segnale a banda limitata."
    },
    {
      "simbolo": "M",
      "significato": "Semiampiezza dell’intervallo di variabilità dei campioni."
    },
    {
      "simbolo": "\\varepsilon_n",
      "significato": "Errore di quantizzazione: livello meno campione."
    },
    {
      "simbolo": "\\Delta",
      "significato": "Ampiezza di un intervallo nel caso uniforme."
    },
    {
      "simbolo": "T_b,R_b",
      "significato": "Durata di bit e velocità binaria senza overhead."
    }
  ],
  "varianti_notazione": [
    {
      "canonica": "$\\omega_s=2\\pi/T$",
      "variante": "$f_{0}=\\frac{1}{T}$",
      "fonte": "file3 pp. 7-11"
    }
  ],
  "idea": "Separare la discretizzazione del tempo da quantizzazione e codifica dei valori.",
  "passi": [
    {
      "n": 1,
      "testo": "Scegliere la frequenza per campionare il segnale limitato in banda.",
      "formula": "\\omega_s=\\frac{2\\pi}{T}\\ge 2\\omega_m\\quad\\Longleftrightarrow\\quad f_s\\ge 2f_m",
      "perche": "La separazione delle repliche evita aliasing nel modello ideale; al bordo di uguaglianza valgono le condizioni ulteriori indicate nelle ipotesi.",
      "figura": "catena"
    },
    {
      "n": 2,
      "testo": "Prelevare il valore del segnale agli istanti di campionamento.",
      "formula": "x_n=x(nT)",
      "perche": "Il campionatore discretizza il tempo: i valori dei campioni non sono ancora ridotti a un numero finito di livelli.",
      "figura": "campionamento"
    },
    {
      "n": 3,
      "testo": "Dividere l’intervallo $(-M,M)$ in $L$ intervalli e sostituire ciascun campione con il livello associato: la quantizzazione è irreversibile.",
      "formula": "q_n=Q(x_n),\\quad x_n\\in(-M,M),\\quad q_n\\in\\{q_1,\\ldots,q_L\\},\\quad\\varepsilon_n=q_n-x_n",
      "perche": "Più valori di ingresso possono produrre lo stesso livello, perciò il valore originale non è recuperabile in generale.",
      "figura": "caratteristica-quantizzatore"
    },
    {
      "n": 4,
      "testo": "Collegare il quantizzatore alla catena e considerare livelli uniformi.",
      "formula": "\\Delta=\\frac{2M}{L},\\qquad |\\varepsilon_n|\\leq\\frac{\\Delta}{2}",
      "perche": "Con livelli rappresentativi al centro degli intervalli il massimo errore in assenza di sovraccarico è metà del passo.",
      "figura": "catena-quantizzazione"
    },
    {
      "n": 5,
      "testo": "Codificare ogni livello con una parola binaria distinta. Per $L=256$ si ottengono $b=8$ bit.",
      "formula": "b=\\lceil\\log_2L\\rceil,\\qquad 2^b\\ge L",
      "perche": "Le parole di lunghezza b devono essere almeno tante quanti i livelli di quantizzazione da distinguere.",
      "figura": "catena-codifica"
    },
    {
      "n": 6,
      "testo": "Emettere in sequenza i bit delle parole e determinare la velocità del segnale numerico. Con $f_s=8\\,\\mathrm{kHz}$ e $b=8$ si ottengono $64\\,\\mathrm{kbit/s}$.",
      "formula": "T_b=\\frac{T}{b},\\qquad R_b=\\frac{b}{T}=\\frac1{T_b}",
      "perche": "Ogni campione produce una parola di b bit in un intervallo T; non sono inclusi bit aggiuntivi di linea.",
      "figura": "catena-segnale-numerico"
    }
  ],
  "formula_finale": "x(t)\\longrightarrow x_n\\longrightarrow q_n\\longrightarrow (b_n^{(1)},\\ldots,b_n^{(b)})",
