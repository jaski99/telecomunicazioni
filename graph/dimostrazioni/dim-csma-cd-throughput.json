{
  "id": "dim-csma-cd-throughput",
  "titolo": "Throughput CSMA/CD nel modello a slot",
  "domande_esame": [
    "T16"
  ],
  "enunciato": "Nel modello CSMA/CD a slot con $N\\ge2$ stazioni indipendenti, probabilità di tentativo $p$ e $A=Np(1-p)^{N-1}>0$, il throughput è $S=\\frac{1}{1+2a(1-A)/A}$. Il massimo della probabilità di successo si ottiene per $p=1/N$ ed è $A_{\\max}=\\left(1-\\frac{1}{N}\\right)^{N-1}$. Il rapporto $a=T_p/T_f$, con $T_p$ tempo di propagazione unidirezionale, $T_f$ durata del frame e $0<a\\le1/2$, è un’interpretazione da verificare sui lucidi.",
  "ipotesi": [
    "Bus condiviso, N stazioni uguali e indipendenti; in ciascuno slot di contesa ciascuna tenta con probabilità p costante.",
    "Gli slot falliti, vuoti o con collisione, sono indipendenti e durano $2T_p$; lo slot che contiene l’avvio riuscito è incluso nel frame, non contato anche come attesa.",
    "Frame riusciti di durata costante $T_f$; traffico disponibile e nessun overhead aggiuntivo nel modello di ciclo.",
    "Definiamo $a=T_p/T_f$; per la rilevazione della collisione entro il frame consideriamo $0<a\\le1/2$, con $a=0$ solo come limite.",
    "IPOTESI: l’interpretazione normalizzata di a è dedotta dal frame unitario e dallo slot di doppia propagazione negli appunti; slide originale NON TROVATO."
  ],
  "notazione": [
    {
      "simbolo": "N,p",
      "significato": "Numero di stazioni e probabilità indipendente di tentare in uno slot."
    },
    {
      "simbolo": "T_p,T_f",
      "significato": "Propagazione unidirezionale e durata del frame riuscito."
    },
    {
      "simbolo": "a",
      "significato": "Rapporto adimensionale $T_p/T_f$."
    },
    {
      "simbolo": "A",
      "significato": "Probabilità che esattamente una stazione tenti nello slot."
    },
    {
      "simbolo": "w",
      "significato": "Numero di slot falliti prima del successo."
    },
    {
      "simbolo": "S",
      "significato": "Frazione di tempo del ciclo dedicata al frame riuscito."
    }
  ],
  "varianti_notazione": [],
  "idea": "Usa una distribuzione geometrica per gli slot falliti e dividi il tempo utile per il ciclo medio.",
  "passi": [
    {
      "n": 1,
      "testo": "Normalizza la durata dello slot e del frame.",
      "formula": "T_{\\mathrm{slot}}=2T_p=2aT_f,\\qquad \\frac{T_f}{T_{\\mathrm{slot}}}=\\frac1{2a}",
      "perche": "La propagazione va e ritorna; $1/(2a)$ è una durata misurata in numero di slot.",
      "figura": "csma-cd-contesa"
    },
    {
      "n": 2,
      "testo": "Calcola la probabilità che una sola stazione tenti.",
      "formula": "A=\\binom N1p(1-p)^{N-1}=Np(1-p)^{N-1}",
      "perche": "Ci sono N possibili stazioni vincenti e le altre N−1 devono restare silenziose indipendentemente."
    },
    {
      "n": 3,
      "testo": "Massimizza A rispetto a p per $N\\ge2$.",
      "formula": "p=1/N,\\qquad A_{\\max}=\\left(1-\\frac1N\\right)^{N-1}\\xrightarrow[N\\to\\infty]{}\\frac1e",
      "perche": "Derivando $Np(1-p)^{N-1}$ il massimo interno si trova a $p=1/N$."
    },
    {
      "n": 4,
      "testo": "Conta solo gli slot falliti prima dell’avvio riuscito.",
      "formula": "P(w=i)=(1-A)^iA,\\quad i=0,1,\\ldots,\\qquad E[w]=\\frac{1-A}{A}",
      "perche": "La legge geometrica conta i fallimenti prima del primo successo; lo slot riuscito appartiene al frame."
    },
    {
      "n": 5,
      "testo": "Dividi la durata di un frame riuscito per la durata media del ciclo.",
      "formula": "S=\\frac{T_f}{T_f+2T_pE[w]}=\\frac{1}{1+2a(1-A)/A}=\\frac{A}{A+2a(1-A)}",
      "perche": "Il ciclo include un frame e in media $E[w]$ slot falliti da $2T_p$ ciascuno.",
      "figura": "csma-cd-throughput-grafico"
    },
    {
      "n": 6,
      "testo": "Sostituisci il valore ottimo di A per disegnare le curve al variare di a.",
      "formula": "S_{\\max}(a,N)=\\frac{1}{1+2a(1-A_{\\max})/A_{\\max}}",
      "perche": "Per $a>0$ la frazione cresce con A; la curva è riferita al modello ottimizzato, non a ogni carico."
    }
  ],
  "formula_finale": "S_{\\max}(a,N)=\\frac{1}{1+2a\\dfrac{1-A_{\\max}}{A_{\\max}}},\\qquad A_{\\max}=\\left(1-\\frac1N\\right)^{N-1},\\quad N\\ge2.",
