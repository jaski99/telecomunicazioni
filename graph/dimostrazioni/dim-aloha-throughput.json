{
  "id": "dim-aloha-throughput",
  "titolo": "Throughput normalizzato ALOHA",
  "domande_esame": [
    "T15",
    "M2",
    "M3"
  ],
  "enunciato": "Nel modello ALOHA ideale, con trame uguali e tentativi poissoniani, sia $G$ il carico totale normalizzato, incluse le ritrasmissioni: il throughput puro è $\\rho_{\\mathrm{puro}}=Ge^{-2G}$ e raggiunge il massimo $1/(2e)$ per $G=1/2$. Con slot sincronizzati è $\\rho_{\\mathrm{slot}}=Ge^{-G}$ e raggiunge il massimo $1/e$ per $G=1$.",
  "ipotesi": [
    "Trame tutte lunghe $b$ bit, capacità $R>0$ e durata $\\tau=b/R$ costante.",
    "Nel modello ideale, gli altri tentativi complessivi, incluse le ritrasmissioni, sono poissoniani e indipendenti dal tentativo di riferimento.",
    "Qualsiasi sovrapposizione provoca collisione distruttiva; niente cattura o errori indipendenti.",
    "Nello slotted tutti iniziano sui confini di slot sincronizzati di durata $\\tau$; il modello non prova da solo la stabilità delle code."
  ],
  "notazione": [
    {
      "simbolo": "b,R,\\tau",
      "significato": "Lunghezza in bit, capacità in bit/s e tempo di trama $\\tau=b/R$."
    },
    {
      "simbolo": "\\lambda_t",
      "significato": "Tasso totale di tentativi, incluse ritrasmissioni."
    },
    {
      "simbolo": "\\lambda",
      "significato": "Tasso di pacchetti trasmessi con successo."
    },
    {
      "simbolo": "G",
      "significato": "Traffico totale normalizzato $G=\\lambda_t\\tau$."
    },
    {
      "simbolo": "\\rho",
      "significato": "Throughput utile normalizzato $\\rho=\\lambda\\tau$."
    },
    {
      "simbolo": "P_s",
      "significato": "Probabilità di successo del tentativo di riferimento."
    },
    {
      "simbolo": "\\lambda_r",
      "significato": "Tasso delle ritrasmissioni: $\\lambda_t=\\lambda+\\lambda_r$, come in lucidi del docente, AccessoMultiplo.pdf, sezione sulle prestazioni di ALOHA."
    }
  ],
  "varianti_notazione": [],
  "idea": "Calcola la probabilità di zero tentativi concorrenti nella finestra vulnerabile e moltiplica per il carico.",
  "passi": [
    {
      "n": 1,
      "testo": "Normalizza traffico totale e throughput rispetto alla durata di trama.",
      "formula": "\\tau=b/R,\\qquad G=\\lambda_t\\tau,\\qquad \\rho=\\lambda\\tau",
      "perche": "Tasso di trame moltiplicato per la durata di una trama è una quantità adimensionale."
    },
    {
      "n": 2,
      "testo": "Individua la finestra vulnerabile dell’ALOHA puro.",
      "formula": "\\text{inizio concorrente}\\in(t-\\tau,t+\\tau),\\qquad |\\text{finestra}|=2\\tau",
      "perche": "Una trama che inizi entro una durata prima o dopo si sovrappone a quella di riferimento.",
      "figura": "aloha-finestra-puro"
    },
    {
      "n": 3,
      "testo": "Applica la probabilità poissoniana di zero tentativi concorrenti.",
      "formula": "P_s=P(N(2\\tau)=0)=e^{-2\\lambda_t\\tau}=e^{-2G}",
      "perche": "Nel modello Poisson un intervallo di lunghezza $2\\tau$ contiene in media $2\\lambda_t\\tau$ tentativi."
    },
    {
      "n": 4,
      "testo": "Individua la finestra vulnerabile con slot sincronizzati e la sua probabilità di successo.",
      "formula": "|\\text{finestra slot}|=\\tau,\\qquad P_{s,\\mathrm{slot}}=e^{-\\lambda_t\\tau}=e^{-G}",
      "perche": "Solo gli altri tentativi nello stesso slot possono sovrapporsi alla trama di riferimento.",
      "figura": "aloha-finestra-slotted"
    },
    {
      "n": 5,
      "testo": "Ricava la frazione di tentativi con successo.",
      "formula": "\\lambda=\\lambda_tP_s,\\qquad \\rho=Ge^{-2G}",
      "perche": "Il tasso di successi è il tasso totale moltiplicato per la probabilità di successo.",
      "figura": "aloha-throughput-puro"
    },
    {
      "testo": "Moltiplica il carico per la probabilità di successo dello slotted e aggiungi la sua curva.",
      "formula": "\\rho_{\\mathrm{slot}}=G P_{s,\\mathrm{slot}}=Ge^{-G}",
      "perche": "La normalizzazione è la stessa del puro: varia soltanto la probabilità di non avere concorrenti, perché la finestra vulnerabile è dimezzata.",
      "figura": "aloha-throughput-puro-slotted",
      "n": 6
    },
    {
      "n": 7,
      "testo": "Deriva le curve per individuare i massimi e confrontali.",
      "formula": "\\begin{aligned}\\rho_{\\mathrm{puro}}^{\\prime}&=e^{-2G}(1-2G)=0\\ \\Rightarrow\\ G=\\tfrac12,\\quad \\rho_{\\max,\\mathrm{puro}}=\\frac1{2e}\\approx0{,}1839\\\\ \\rho_{\\mathrm{slot}}^{\\prime}&=e^{-G}(1-G)=0\\ \\Rightarrow\\ G=1,\\quad \\rho_{\\max,\\mathrm{slot}}=\\frac1e\\approx0{,}3679\\end{aligned}",
      "perche": "Gli esponenziali sono positivi: i cambi di segno delle derivate avvengono a $G=1/2$ e $G=1$.",
      "figura": "aloha-throughput-grafico"
    }
  ],
  "formula_finale": "\\begin{aligned}\\rho_{\\mathrm{puro}}&=Ge^{-2G},&\\rho_{\\max,\\mathrm{puro}}&=\\frac1{2e}\\approx0{,}1839\\quad(G=\\tfrac12),\\\\ \\rho_{\\mathrm{slot}}&=Ge^{-G},&\\rho_{\\max,\\mathrm{slot}}&=\\frac1e\\approx0{,}3679\\quad(G=1).\\end{aligned}",
