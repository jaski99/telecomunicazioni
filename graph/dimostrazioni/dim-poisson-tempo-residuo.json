{
  "id": "dim-poisson-tempo-residuo",
  "titolo": "Distribuzione del tempo residuo poissoniano",
  "domande_esame": [
    "T13"
  ],
  "enunciato": "Per un processo di Poisson omogeneo di tasso $\\lambda>0$, sia $X$ l’interarrivo e sia $R=X-t_0$ il tempo residuo sapendo che $X>t_0$, con $t_0\\ge0$. Per ogni $r\\ge0$ vale $P(R>r\\mid X>t_0)=e^{-\\lambda r}$: il residuo è esponenziale con lo stesso tasso e non dipende dal tempo già atteso.",
  "ipotesi": [
    "Arrivi di Poisson omogenei con tasso costante $\\lambda>0$; intervalli disgiunti hanno incrementi indipendenti.",
    "$X$ è il tempo interarrivo dopo un evento; si osserva $X>t_0$ per un tempo fissato $t_0\\ge0$.",
    "Si considera $r\\ge0$ e il residuo $R=X-t_0$ condizionatamente a $X>t_0$."
  ],
  "notazione": [
    {
      "simbolo": "\\lambda",
      "significato": "Tasso di arrivi, in eventi per secondo."
    },
    {
      "simbolo": "X",
      "significato": "Tempo tra due arrivi successivi."
    },
    {
      "simbolo": "t_0",
      "significato": "Tempo già atteso senza nuovi arrivi."
    },
    {
      "simbolo": "R,r",
      "significato": "Tempo residuo e valore non negativo a cui se ne valuta la distribuzione."
    },
    {
      "simbolo": "F_R(r)",
      "significato": "Probabilità condizionata che il residuo non superi r."
    }
  ],
  "varianti_notazione": [
    {
      "canonica": "$\\lambda$",
      "variante": "$\\lambda$",
      "fonte": "file1 pp. 51–53 e file3 p. 47, immagini: usano lambda senza pedice; nessuna variante del tasso trovata in queste pagine."
    },
    {
      "canonica": "r",
      "variante": "$\\delta$",
      "fonte": "file1 p. 53 e file3 p. 47, immagini: delta indica la durata residua."
    }
  ],
  "idea": "La sopravvivenza esponenziale si fattorizza: il tempo trascorso si elimina nel rapporto condizionato.",
  "passi": [
    {
      "n": 1,
      "testo": "Dalla probabilità di zero eventi in t ricava la sopravvivenza dell’interarrivo.",
      "formula": "P(X>t)=P(N(t)=0)=e^{-\\lambda t},\\qquad t\\ge0",
      "perche": "Nessun arrivo entro t equivale al primo arrivo successivo a t.",
      "figura": "poisson-sopravvivenza-interarrivo"
    },
    {
      "n": 2,
      "testo": "Scrivi la distribuzione e la densità dell’interarrivo.",
      "formula": "F_X(t)=1-e^{-\\lambda t},\\qquad f_X(t)=\\lambda e^{-\\lambda t}",
      "perche": "Si prende il complementare della sopravvivenza e si deriva la distribuzione per t positivo."
    },
    {
      "n": 3,
      "testo": "Esprimi l’evento residuo mediante la probabilità condizionata.",
      "formula": "P(R>r\\mid X>t_0)=\\frac{P(X>t_0+r)}{P(X>t_0)}",
      "perche": "Per r non negativo, $X>t_0+r$ implica $X>t_0$, e il denominatore è positivo."
    },
    {
      "n": 4,
      "testo": "Sostituisci le due sopravvivenze e semplifica.",
      "formula": "P(R>r\\mid X>t_0)=\\frac{e^{-\\lambda(t_0+r)}}{e^{-\\lambda t_0}}=e^{-\\lambda r}",
      "perche": "L’esponenziale del tempo totale si separa nel prodotto delle due durate.",
      "figura": "poisson-densita-condizionata"
    },
    {
      "testo": "La probabilità condizionata non dipende dal tempo già trascorso: è l’assenza di memoria della distribuzione esponenziale.",
      "formula": "P(R>r\\mid X>t_0)=P(X>r)=e^{-\\lambda r}",
      "perche": "Il fattore relativo a $t_0$ si è cancellato: il residuo ha la stessa legge di una nuova attesa, non una durata ridotta dal tempo già passato.",
      "figura": "poisson-sopravvivenza-residuo",
      "n": 5
    },
    {
      "testo": "Prendi il complementare per ottenere la funzione di ripartizione del residuo.",
      "formula": "F_R(r)=P(R\\le r\\mid X>t_0)=1-e^{-\\lambda r}",
      "perche": "Entro una durata r o si verifica il prossimo arrivo oppure si sopravvive oltre r: i due eventi sono complementari, come in file1 p. 53.",
      "figura": "poisson-distribuzione-residuo",
      "n": 6
    },
    {
      "n": 7,
      "testo": "Integra la sopravvivenza per trovare il valore medio del residuo.",
      "formula": "E[R\\mid X>t_0]=\\int_0^\\infty e^{-\\lambda r}\\,dr=\\frac1\\lambda",
      "perche": "Per una variabile non negativa si integra la sopravvivenza. Il valore medio $1/\\lambda$ non dipende da $t_0$: chi ha già atteso non attende meno."
    }
  ],
  "formula_finale": "F_R(r)=P(R\\le r\\mid X>t_0)=1-e^{-\\lambda r},\\qquad E[R\\mid X>t_0]=\\frac1\\lambda\\quad(r\\ge0).",
