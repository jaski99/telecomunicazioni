{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mappa esame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "versione",
    "avvertenza",
    "prove"
  ],
  "properties": {
    "versione": {
      "const": 1
    },
    "avvertenza": {
      "type": "string",
      "minLength": 1
    },
    "prove": {
      "type": "array",
      "minItems": 69,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tipo",
          "titolo",
          "punti",
          "nodi",
          "fonte"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(T([1-9]|1[0-7])|E[1-9]|M([1-9]|[12][0-9]|3[0-4])|I[1-9])$"
          },
          "tipo": {
            "enum": [
              "teoria",
              "esercizio",
              "quiz",
              "intro_reti"
            ]
          },
          "titolo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "punti": {
            "oneOf": [
              {
                "const": 10
              },
              {
                "const": "NON TROVATO"
              }
            ]
          },
          "nodi": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "fonte": {
            "const": "FILE2"
          }
        }
      }
    }
  }
}
