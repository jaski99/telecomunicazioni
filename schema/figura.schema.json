{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaski99.github.io/telecomunicazioni/schema/figura.schema.json",
  "title": "Figura",
  "description": "Figura SVG dichiarativa — CONTRACTS §3.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tipo", "titolo", "descrizione"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "tipo": {
      "type": "string",
      "enum": ["grafico", "blocchi", "temporale"]
    },
    "titolo": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "descrizione": {
      "type": "string",
      "minLength": 30
    },
    "asse_x": {
      "type": "object",
      "additionalProperties": false,
      "required": ["etichetta", "min", "max"],
      "properties": {
        "etichetta": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "tacche": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valore", "etichetta"],
            "properties": {
              "valore": { "type": "number" },
              "etichetta": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "asse_y": {
      "type": "object",
      "additionalProperties": false,
      "required": ["etichetta", "min", "max"],
      "properties": {
        "etichetta": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "tacche": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["valore", "etichetta"],
            "properties": {
              "valore": { "type": "number" },
              "etichetta": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "serie": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stile", "punti"],
        "properties": {
          "stile": {
            "type": "string",
            "enum": ["linea", "tratteggio", "righe", "punti"]
          },
          "punti": {
            "type": "array",
            "minItems": 1,
            "maxItems": 800,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          },
          "etichetta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "annotazioni": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y", "testo"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "testo": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blocchi": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "etichetta", "forma", "colonna", "riga"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "etichetta": { "type": "string", "minLength": 1 },
          "forma": {
            "type": "string",
            "enum": ["rettangolo", "sommatore", "moltiplicatore", "ritardo", "nodo", "ingresso", "uscita"]
          },
          "colonna": { "type": "integer", "minimum": 0, "maximum": 12 },
          "riga": { "type": "integer", "minimum": 0, "maximum": 6 }
        }
      }
    },
    "collegamenti": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["da", "a"],
        "properties": {
          "da": { "type": "string", "minLength": 1 },
          "a": { "type": "string", "minLength": 1 },
          "etichetta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "asse_t": {
      "type": "object",
      "additionalProperties": false,
      "required": ["etichetta", "min", "max"],
      "properties": {
        "etichetta": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "corsie": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "etichetta"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "etichetta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "intervalli": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["corsia", "t0", "t1", "stile"],
        "properties": {
          "corsia": { "type": "string", "minLength": 1 },
          "t0": { "type": "number" },
          "t1": { "type": "number" },
          "etichetta": { "type": "string", "minLength": 1 },
          "stile": {
            "type": "string",
            "enum": ["trasmissione", "attesa", "collisione", "ack"]
          }
        }
      }
    },
    "frecce": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["da", "a"],
        "properties": {
          "da": {
            "type": "object",
            "additionalProperties": false,
            "required": ["corsia", "t"],
            "properties": {
              "corsia": { "type": "string", "minLength": 1 },
              "t": { "type": "number" }
            }
          },
          "a": {
            "type": "object",
            "additionalProperties": false,
            "required": ["corsia", "t"],
            "properties": {
              "corsia": { "type": "string", "minLength": 1 },
              "t": { "type": "number" }
            }
          },
          "etichetta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "marcatori": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["t", "etichetta"],
        "properties": {
          "t": { "type": "number" },
          "etichetta": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "tipo": { "const": "grafico" } } },
      "then": { "required": ["asse_x", "asse_y", "serie"] }
    },
    {
      "if": { "properties": { "tipo": { "const": "blocchi" } } },
      "then": { "required": ["blocchi", "collegamenti"] }
    },
    {
      "if": { "properties": { "tipo": { "const": "temporale" } } },
      "then": { "required": ["asse_t", "corsie", "intervalli"] }
    },
    {
      "if": { "properties": { "tipo": { "const": "grafico" } } },
      "then": {
        "properties": {
          "blocchi": false,
          "collegamenti": false,
          "asse_t": false,
          "corsie": false,
          "intervalli": false,
          "frecce": false,
          "marcatori": false
        }
      }
    },
    {
      "if": { "properties": { "tipo": { "const": "blocchi" } } },
      "then": {
        "properties": {
          "asse_x": false,
          "asse_y": false,
          "serie": false,
          "annotazioni": false,
          "asse_t": false,
          "corsie": false,
          "intervalli": false,
          "frecce": false,
          "marcatori": false
        }
      }
    },
    {
      "if": { "properties": { "tipo": { "const": "temporale" } } },
      "then": {
        "properties": {
          "asse_x": false,
          "asse_y": false,
          "serie": false,
          "annotazioni": false,
          "blocchi": false,
          "collegamenti": false
        }
      }
    }
  ]
}
