{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaski99.github.io/telecomunicazioni/schema/dimostrazione.schema.json",
  "title": "Dimostrazione",
  "description": "Dimostrazione nel formato didattico — CONTRACTS §3.3 e IMPROVEMENT_PLAN §3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "titolo",
    "domande_esame",
    "enunciato",
    "ipotesi",
    "notazione",
    "idea",
    "passi",
    "formula_finale",
    "figure",
    "a_voce",
    "errori_frequenti",
    "versione_compatta",
    "a_buchi",
    "richiamo_attivo",
    "fonti",
    "verifica"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "titolo": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "domande_esame": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(T([1-9]|1[0-7])|M([1-9]|[12][0-9]|3[0-4])|E[1-9]|I[1-9])$"
      }
    },
    "enunciato": {
      "type": "string",
      "minLength": 40
    },
    "ipotesi": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "notazione": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["simbolo", "significato"],
        "properties": {
          "simbolo": { "type": "string", "minLength": 1 },
          "significato": { "type": "string", "minLength": 1 }
        }
      }
    },
    "varianti_notazione": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["canonica", "variante", "fonte"],
        "properties": {
          "canonica": { "type": "string", "minLength": 1 },
          "variante": { "type": "string", "minLength": 1 },
          "fonte": { "type": "string", "minLength": 1 }
        }
      }
    },
    "idea": {
      "type": "string",
      "minLength": 20,
      "maxLength": 200
    },
    "passi": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "testo", "perche"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "testo": { "type": "string", "minLength": 1 },
          "formula": { "type": "string", "minLength": 1 },
          "perche": { "type": "string", "minLength": 15 },
          "figura": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "formula_finale": {
      "type": "string",
      "minLength": 1
    },
    "figure": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "figura.schema.json" }
    },
    "a_voce": {
      "type": "string",
      "minLength": 300,
      "maxLength": 1500
    },
    "errori_frequenti": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["errore", "perche_sbagliato", "correzione"],
        "properties": {
          "errore": { "type": "string", "minLength": 1 },
          "perche_sbagliato": { "type": "string", "minLength": 1 },
          "correzione": { "type": "string", "minLength": 1 }
        }
      }
    },
    "versione_compatta": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "a_buchi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testo", "soluzioni"],
      "properties": {
        "testo": { "type": "string", "minLength": 1 },
        "soluzioni": {
          "type": "object",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "richiamo_attivo": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domanda", "risposta"],
        "properties": {
          "domanda": { "type": "string", "minLength": 1 },
          "risposta": { "type": "string", "minLength": 1 }
        }
      }
    },
    "collegamenti": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "fonti": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chiave", "rif"],
        "properties": {
          "chiave": { "type": "string", "minLength": 1 },
          "rif": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verifica": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stato", "data", "note", "punti_aperti"],
      "properties": {
        "stato": {
          "type": "string",
          "enum": [
            "verificata_testo_prof",
            "verificata_file1_file3",
            "solo_file3",
            "ricostruzione_non_del_prof",
            "da_verificare"
          ]
        },
        "data": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": { "type": "string", "minLength": 1 },
        "punti_aperti": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
